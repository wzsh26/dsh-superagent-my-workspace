{
  "name": "memora-bigfive",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "大五人格档案 2.5：列表（会话页显示助理开关 / 添加 / 保存草稿）→ 详情六 Tab（人物概述 / 关键经历 / 评分详情 / 来源故事 / 互动记录 / 情绪波动）；头部含简介与只读标签，人物摘要固定三段，简介最多 20 字。",
  "files": [
    "index.js",
    "client.js",
    "locale/*.json",
    "icon.svg"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
